# Copy this file to .env for local development, or set these as
# environment variables directly in the Netlify dashboard
# (Site settings -> Environment variables) for deployed builds.
#
# Never commit a real .env file — it's excluded by .gitignore.

# Gmail account used to send enquiry / competition-entry notification
# emails via netlify/functions (see netlify/functions/_mail.js).
# GMAIL_PASS must be a Google App Password, not the account's login password.
GMAIL_USER=your-sending-address@gmail.com
GMAIL_PASS=your-16-character-app-password
